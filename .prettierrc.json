{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "plugins": [
        "prettier-plugin-organize-imports",
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [
        {
            "files": [
                "**/login/pages/*.tsx",
                "**/account/pages/*.tsx",
                "**/login/Template.tsx",
                "**/account/Template.tsx",
                "**/login/UserProfileFormFields.tsx",
                "KcApp.tsx"
            ],
            "options": {
                "printWidth": 150
            }
        }
    ]
}