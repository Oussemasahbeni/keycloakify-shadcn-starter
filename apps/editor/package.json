{
    "name": "@kc-studio/editor",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "copy-template-jar": "node scripts/copy-template-jar.mjs",
        "predev": "([ ! -f .env ] && cp .env.sample .env || true) && node scripts/copy-template-jar.mjs",
        "dev": "vite dev --port 3000",
        "prebuild": "node scripts/copy-template-jar.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "pretest": "node scripts/copy-template-jar.mjs",
        "test": "vitest run",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "check": "prettier --check .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "packageManager": "pnpm@11.0.0",
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@fontsource-variable/geist": "^5.2.9",
        "@icons-pack/react-simple-icons": "^13.13.0",
        "@kc-studio/shadcn-theme": "workspace:*",
        "@neondatabase/serverless": "^1.0.2",
        "@tanstack/react-devtools": "catalog:tanstack",
        "@tanstack/react-form": "catalog:tanstack",
        "@tanstack/react-query": "catalog:tanstack",
        "@tanstack/react-router": "catalog:tanstack",
        "@tanstack/react-router-devtools": "catalog:tanstack",
        "@tanstack/react-router-ssr-query": "catalog:tanstack",
        "@tanstack/react-start": "catalog:tanstack",
        "@tanstack/router-plugin": "catalog:tanstack",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-kit": "^0.31.9",
        "drizzle-orm": "^0.45.1",
        "fflate": "^0.8.3",
        "lucide-react": "^0.577.0",
        "nitro": "3.0.260610-beta",
        "oidc-spa": "10.3.0-rc.4",
        "png-to-ico": "^3.0.1",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-resizable-panels": "^4.11.2",
        "sharp": "^0.35.2",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "catalog:",
        "tw-animate-css": "^1.3.6",
        "tsafe": "^1.8.12",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/typography": "^0.5.19",
        "@tanstack/devtools-vite": "catalog:tanstack",
        "@tanstack/eslint-config": "catalog:tanstack",
        "@tanstack/eslint-plugin-query": "catalog:tanstack",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@tailwindcss/vite": "catalog:",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv": "^17.3.1",
        "eslint": "^10.4.0",
        "jsdom": "^28.1.0",
        "shadcn": "^4.15.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vite": "^8.1.0",
        "vitest": "^4.1.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    }
}