        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv": "^17.3.1",
        "eslint": "^10.4.0",
        "jsdom": "^28.1.0",
        "shadcn": "^4.8.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.0",
        "vitest": "^4.1.5"
