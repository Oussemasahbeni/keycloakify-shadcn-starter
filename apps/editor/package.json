{
    "name": "@kc-studio/editor",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "copy-template-jar": "node scripts/copy-template-jar.mjs",
        "predev": "node scripts/copy-template-jar.mjs",
        "dev": "vite dev --port 3000",
        "prebuild": "node scripts/copy-template-jar.mjs",
